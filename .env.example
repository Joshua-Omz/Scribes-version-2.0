# Copy this file to .env and fill in the values before running locally.
# The .env file is git-ignored; never commit secrets.

DATABASE_URL=postgres://scribes:scribes_secret@localhost:5432/scribes?sslmode=disable
JWT_SECRET=change_me_to_a_long_random_string
SERVER_PORT=8080
MIGRATIONS_PATH=file://migrations

# --- Storage Configuration (R2 Compatible) ---

Cloudflare R2 Storage (Production)
Uncomment these and fill in your details for production
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=scribes-media
R2_ACCESS_KEY_ID=<key-from-r2-dashboard>
R2_SECRET_ACCESS_KEY=<secret-from-r2-dashboard>
R2_PUBLIC_URL=https://r2.scribes.app

MinIO Storage (Development)
Used for local development testing
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=scribes-media
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_PUBLIC_URL=http://localhost:9000/scribes-media
